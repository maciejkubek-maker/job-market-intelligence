		formatString: 0
		lineageTag: 4b6f4d17-bd6f-49ac-bcac-79cc28a3a8ce

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Active Remote Jobs' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2[snapshot_date])
			    )
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(vw_job_snapshots_v2[job_id]),
			        vw_job_snapshots_v2[snapshot_date] = LatestDate,
			        vw_job_snapshots_v2[is_remote] = TRUE()
			    )
		formatString: #,0
		lineageTag: 494e44ee-e179-45ff-b9b8-b5af4c33fcc5

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Active Remote %' =
			
			DIVIDE([Active Remote Jobs], [Active Jobs])
		formatString: 0.0%
		lineageTag: 6037bbd4-4209-4177-b67a-c18cbbc02839

	measure 'Active Jobs By Remote Status' =
			
			VAR LatestDate =
