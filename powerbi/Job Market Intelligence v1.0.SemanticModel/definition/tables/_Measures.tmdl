		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Disappeared Jobs vs Previous Snapshot' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2)
			    )
			VAR PreviousDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2),
			        vw_job_snapshots_v2[snapshot_date] < LatestDate
			    )
			VAR CurrentJobs =
			    CALCULATETABLE(
			        VALUES(vw_job_snapshots_v2[job_id]),
			        REMOVEFILTERS(vw_job_snapshots_v2),
