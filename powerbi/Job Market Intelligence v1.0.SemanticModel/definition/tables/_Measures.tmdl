table _Measures
	lineageTag: c0c09078-0f8b-4940-8653-357c67254dfa

	measure 'Active Jobs' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2[snapshot_date])
			    )
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(vw_job_snapshots_v2[job_id]),
			        vw_job_snapshots_v2[snapshot_date] = LatestDate
			    )
		formatString: 0
		lineageTag: e4100b3b-7399-4d68-8db7-4f2dfa5edfac

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Unique Jobs' =
			
			DISTINCTCOUNT(vw_job_snapshots_v2[job_id])
		formatString: 0
		lineageTag: 008aa9ce-e938-4388-b34f-b07be24aad48

	measure 'Unique Skills' =
			
			DISTINCTCOUNT(vw_job_skills_v2[skill_name])
		formatString: 0
		lineageTag: c1e70db5-ae15-4383-a019-ade1dc28204c

	measure 'Top 5 Skills' =
			
			VAR SkillRank =
			    RANKX(
			        ALLSELECTED(vw_job_skills_v2[skill_name]),
			        CALCULATE(
			            DISTINCTCOUNT(vw_job_skills_v2[job_id]),
			            REMOVEFILTERS(vw_job_skills_v2[snapshot_date])
			        ),
			        ,
			        DESC,
			        DENSE
			    )
			RETURN
			    IF(SkillRank <= 5, 1, 0)
		formatString: 0
		lineageTag: c48a6cae-5b00-4c17-8aa2-bbb2a829d985

	measure 'Report Data On' =
			
			
			FORMAT(
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS()
			    ),
			    "dd MMM yyyy",
			    "en-US"
			)
		lineageTag: 3bfcead1-345a-4d41-8479-02e3f842be7f

	measure Last_day_unique_jobs =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2)
			    )
			VAR PreviousDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2),
			        vw_job_snapshots_v2[snapshot_date] < LatestDate
			    )
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(vw_job_snapshots_v2[job_id]),
			        REMOVEFILTERS(vw_job_snapshots_v2),
			        vw_job_snapshots_v2[snapshot_date] = PreviousDate
			    )
		formatString: 0
		lineageTag: e31a038a-c444-4549-94a9-8e2fcf9648df

	measure 'Jobs Change % vs Previous Snapshot' =
			
			DIVIDE(
			    [Active Jobs] - [Last_day_unique_jobs],
			    [Last_day_unique_jobs]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8c3250d5-ecbf-478f-bedc-0b8b1383c1b6

	measure 'New Jobs vs Previous Snapshot' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2)
			    )
			VAR PreviousDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2),
			        vw_job_snapshots_v2[snapshot_date] < LatestDate
			    )
			VAR CurrentJobs =
			    CALCULATETABLE(
			        VALUES(vw_job_snapshots_v2[job_id]),
			        REMOVEFILTERS(vw_job_snapshots_v2),
			        vw_job_snapshots_v2[snapshot_date] = LatestDate
			    )
			VAR PreviousJobs =
			    CALCULATETABLE(
			        VALUES(vw_job_snapshots_v2[job_id]),
			        REMOVEFILTERS(vw_job_snapshots_v2),
			        vw_job_snapshots_v2[snapshot_date] = PreviousDate
			    )
			RETURN
			    COUNTROWS(EXCEPT(CurrentJobs, PreviousJobs))
		formatString: 0
		lineageTag: a1ee2b44-c202-4cd4-953e-904f54b093b0

	measure 'Job Postings with Skill' =
			
