		formatString: 0
		lineageTag: ba69e9ec-0e86-4169-b82d-b134c59fb7c6

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Net Job Change vs Previous Snapshot' =
			
			[New Jobs vs Previous Snapshot] - [Disappeared Jobs vs Previous Snapshot]
		formatString: +#,0;-#,0;0
		lineageTag: d820929a-3cb4-4b33-b462-ca2baef5a2ea

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Matching Active Jobs' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2[snapshot_date])
			    )
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(vw_job_snapshots_v2[job_id]),
			        vw_job_snapshots_v2[snapshot_date] = LatestDate
			    )
		formatString: #,0
		lineageTag: 81cbd703-b1ea-422f-914f-0a5964a6bfdd

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Matching Remote Opportunities %' =
			
			VAR TotalInScope =
			    CALCULATE(
			        [Matching Active Jobs],
			        REMOVEFILTERS(vw_job_snapshots_v2[is_remote])
			    )
			VAR RemoteInScope =
			    CALCULATE(
			        [Matching Active Jobs],
			        REMOVEFILTERS(vw_job_snapshots_v2[is_remote]),
			        vw_job_snapshots_v2[is_remote] = TRUE()
			    )
			RETURN
			    DIVIDE(RemoteInScope, TotalInScope)
		formatString: 0.0%
		lineageTag: 9035865b-8852-441f-85bb-ab8eba8b6f83

	measure 'Median Monthly Salary (PLN)' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2[snapshot_date])
			    )
			VAR ValidSalaries =
			    FILTER(
			        vw_job_snapshots_v2,
			        vw_job_snapshots_v2[snapshot_date] = LatestDate &&
			        vw_job_snapshots_v2[salary_currency] = "PLN" &&
			        (
			            vw_job_snapshots_v2[salary_period] = "Month" ||
			            vw_job_snapshots_v2[salary_period] = "month" ||
			            vw_job_snapshots_v2[salary_period] = "Miesiąc"
			        ) &&
			        (NOT ISBLANK(vw_job_snapshots_v2[salary_from]) || NOT ISBLANK(vw_job_snapshots_v2[salary_to]))
			    )
			RETURN
			    MEDIANX(
			        ValidSalaries,
			        VAR SFrom = vw_job_snapshots_v2[salary_from]
			        VAR STo = vw_job_snapshots_v2[salary_to]
			        RETURN
			            SWITCH(
			                TRUE(),
			                NOT ISBLANK(SFrom) && NOT ISBLANK(STo), (SFrom + STo) / 2,
			                NOT ISBLANK(SFrom), SFrom,
			                STo
			            )
			    )
		formatString: #,0 "PLN"
		lineageTag: 704acaeb-8735-4ac7-9b6e-a44ab114e8e4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Salary Disclosed Jobs Count' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(vw_job_snapshots_v2[snapshot_date]),
			        REMOVEFILTERS(vw_job_snapshots_v2[snapshot_date])
			    )
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(vw_job_snapshots_v2[job_id]),
			        vw_job_snapshots_v2[snapshot_date] = LatestDate,
			        vw_job_snapshots_v2[salary_currency] = "PLN",
			        (
			            vw_job_snapshots_v2[salary_period] = "Month" ||
			            vw_job_snapshots_v2[salary_period] = "month" ||
			            vw_job_snapshots_v2[salary_period] = "Miesiąc"
			        ),
			        NOT ISBLANK(vw_job_snapshots_v2[salary_from]) || NOT ISBLANK(vw_job_snapshots_v2[salary_to])
			    )
		formatString: #,0
		lineageTag: 6cd17c8e-3a35-4a10-8aa5-adebf03bf127

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Salary Disclosure %' =
			
			DIVIDE([Salary Disclosed Jobs Count], [Matching Active Jobs])
		formatString: 0.0%
		lineageTag: e70a4bf5-6da3-4724-a0f1-146d9b978eab

